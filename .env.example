# Copy this file to .env and fill in your own Supabase project's values.
# Find these under Project Settings -> API in your Supabase dashboard.
# They are safe to ship in the app: the anon key only grants what your
# Row Level Security policies (supabase/schema.sql) allow.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
